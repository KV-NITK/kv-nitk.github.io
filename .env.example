VITE_API_URL=https://kannadavedike.nitk.ac.in/api

# Parva 26 registration forms (Supabase). Both values are safe to ship in the
# browser: the anon key can only INSERT into the literacy_* tables (see
# server/sql/006_parva26_literacy_registrations.sql). Never put the
# service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
