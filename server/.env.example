PORT=5000

# The ONLY place the frontend address/port is set. Vite (dev port + opened URL), the login
# redirect, CORS and the Cashfree return URL are all derived from it.
# local: http://kannadavedike.dev.local:5173   prod: https://kannadavedike.nitk.ac.in
FRONTEND_URL=http://kannadavedike.dev.local:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX
# Optional override. Default: $FRONTEND_URL/payment/status?order_id={order_id}
# CASHFREE_RETURN_URL=
CASHFREE_WEBHOOK_URL=

# IRIS OAuth (callback URLs must be https and registered with the IRIS admin)
IRIS_CLIENT_ID=
IRIS_CLIENT_SECRET=
# local: https://kannadavedike.dev.local:5000/api/auth/iris/callback
# prod:  https://kannadavedike.nitk.ac.in/api/auth/iris/callback
IRIS_REDIRECT_URI=
# Optional overrides; defaults come from https://iris.nitk.ac.in/.well-known/openid-configuration
# IRIS_AUTHORIZE_URL=https://iris.nitk.ac.in/oauth/authorize
# IRIS_TOKEN_URL=https://iris.nitk.ac.in/oauth/token
# IRIS_PROFILE_URL=https://iris.nitk.ac.in/api/v1/users/me.json

# Password for the /admin orders page. The server checks it; unset = the page is off.
ADMIN_PASSCODE=

# Password for the /admin/staff page (who may scan, who may revert). A different password
# from ADMIN_PASSCODE on purpose. The server checks it; unset = the page is off.
STAFF_ADMIN_PASSCODE=

# Password for the photo booth scanner (/parva-26/photobooth/scan), for the booth operator
# who has no IRIS login. It can only claim photo booth passes. Unset = that scanner is off.
PHOTO_BOOTH_PASSCODE=

# When food coupon QR codes open on My Orders (ISO time with offset). Default: 2026-10-30T00:00:00+05:30
FOOD_QR_UNLOCK_AT=

# Where the page-visit counts are kept. Point it at a folder that survives a deploy
# (a mounted volume); unset = server/data, which a new container starts empty.
ANALYTICS_DATA_DIR=
# Mixed into the hash that stands in for a visitor's address. Unset = ADMIN_PASSCODE is used.
ANALYTICS_SALT=
